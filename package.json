{
  "name": "ajc-settlements",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "guards": "bash scripts/guards.sh",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm -r build",
    "verify:fast": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm guards && pnpm test",
    "verify": "pnpm verify:fast && pnpm build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
