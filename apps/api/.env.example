# NODE_ENV: development | test | production. Every deployed environment, dev included, uses production.
NODE_ENV=development
# PORT: HTTP port. 3100 locally, because the web app uses 3000.
PORT=3100
# ALLOWED_ORIGINS: comma-separated browser origins allowed by CORS. Origins only: no path, no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000
# TRUST_PROXY_HOPS: exact number of proxies in front of the API, from 0 to 10. Never "true".
TRUST_PROXY_HOPS=0
# DATABASE_URL: application-role connection string (role ajc_app, the pooled host on Neon). A secret.
# These local values are throwaway and public on purpose: the database listens on 127.0.0.1 only.
DATABASE_URL=postgres://ajc_app:ajc_app_local@localhost:5432/ajc_settlements
# DB_POOL_MAX: connection pool size, 1 to 50. Set to the host's real limit.
DB_POOL_MAX=5
# MIGRATOR_DATABASE_URL: used only by db:migrate (role ajc_migrator, the direct host). The running API never reads it.
MIGRATOR_DATABASE_URL=postgres://ajc_migrator:ajc_migrator_local@localhost:5432/ajc_settlements
# LOG_LEVEL: debug | info | warn | error. Optional, defaults to info.
LOG_LEVEL=info
# RENDER_GIT_COMMIT: optional. Provided by Render; reported by the health endpoints.
# RENDER_GIT_COMMIT=
