{
  "name": "@ajc/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/platform/migrate-cli.js up",
    "db:migrate:revert": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/platform/migrate-cli.js down"
  },
  "dependencies": {
    "@ajc/contracts": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/throttler": "6.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  }
}
