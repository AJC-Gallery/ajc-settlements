# Non-secret settings for apps/web. Nothing here is ever prefixed NEXT_PUBLIC_.
# Local use: copy this file to apps/web/.env.local.

# API_ORIGIN: origin of the API (scheme and host, no path, no trailing slash).
# The server-side /api rewrite forwards to it. The rewrite is fixed at build time,
# so build and start with the same value.
API_ORIGIN=https://api-dev.ajc-gallery.com

# APP_ENV: which environment this build is for: dev or production.
APP_ENV=dev